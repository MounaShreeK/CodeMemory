# Hindsight persistent memory service
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key

# GitHub API access (optional for public repositories; recommended for private repos)
GITHUB_TOKEN=your_github_token

# LLM provider endpoint used by the existing LLMClient
LLM_API_URL=https://your-llm-provider.example/v1/generate
LLM_API_KEY=your_llm_api_key
LLM_MODEL=your_model_name

# Frontend development origins, comma-separated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
LOG_LEVEL=INFO
